{
  "name": "@circulo-ai/di",
  "version": "3.5.2",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "docs.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples"
  ],
  "keywords": [
    "dependency-injection",
    "di",
    "ioc",
    "container",
    "typescript",
    "hono",
    "nextjs"
  ],
  "author": "Circulo AI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/circulo-ai/circulo.git"
  },
  "bugs": {
    "url": "https://github.com/circulo-ai/circulo/issues"
  },
  "homepage": "https://github.com/circulo-ai/circulo#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./compat": {
      "types": "./dist/compat/container.d.ts",
      "import": "./dist/compat/container.js",
      "default": "./dist/compat/container.js"
    },
    "./compat/lazy": {
      "types": "./dist/compat/lazy.d.ts",
      "import": "./dist/compat/lazy.js",
      "default": "./dist/compat/lazy.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js",
      "default": "./dist/devtools/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun ./node_modules/typescript/bin/tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "check": "bun run clean && bun run typecheck && bun run test && bun run build && bun run test:package && bun run test:examples",
    "prepack": "bun run check",
    "test": "bun ./node_modules/vitest/vitest.mjs run",
    "test:package": "node --input-type=module -e \"const di=await import('./dist/index.js');const ok=new di.ServiceCollection().addSingleton('ready',true).build().resolve('ready');if(!ok)process.exit(1)\"",
    "test:examples": "tsc --noEmit -p tsconfig.examples.json && tsc --noEmit -p examples/hono/tsconfig.json && bun examples/annotations.ts && bun examples/real-world.ts && bun examples/hono/src/smoke.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "npm publish --access public"
  },
  "peerDependencies": {
    "hono": "^4.10.7"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^20.19.25",
    "hono": "^4.13.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
